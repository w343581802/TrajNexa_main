# 本机组合镜像：Worker 同时具备 OCR（录像命名/扫描）与 RF-DETR 推理依赖。
# 上游的 Dockerfile.ocr 与 Dockerfile.rfdetr 各自只能覆盖一半能力，二者叠加时用这个文件。
# 构建入口见 compose.worker-rfdetr.yaml。
FROM python:3.12-slim
WORKDIR /srv
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-track.txt requirements-rfdetr.txt ./
# 同 Dockerfile.rfdetr：先装 CPU 版 torch，避免 rfdetr 依赖把 CUDA 运行时带进镜像。
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch torchvision
RUN pip install --no-cache-dir -r requirements-rfdetr.txt \
    && pip install --no-cache-dir -r requirements-track.txt
# CPU 版 Paddle 必须在 PaddleOCR 3.x 之前装；3.7 起默认 PP-OCRv6，与 Dockerfile.ocr 保持一致。
RUN pip install --no-cache-dir 'paddlepaddle==3.2.0' 'paddleocr>=3.7,<3.8'
COPY . .
ENV PYTHONPATH=/srv