DATABASE_URL=postgresql+psycopg://trajnexa:dev_only_change_me@db:5432/trajnexa
STORAGE_ROOT=/data/storage
MAX_UPLOAD_BYTES=268435456
WORKER_POLL_SECONDS=2
# OCR optional. Requires PaddleOCR/PaddlePaddle in worker image (see design/03)
OCR_ENABLED=false
# M1c: optional local camera catalog JSON in STORAGE_ROOT/camera_catalog.json
# Enable secondary camera-name ROI analysis only in an OCR Worker
NAME_ROI_ENABLED=true
# Optional, read-only TrajNexa_Map PostgreSQL; set only in local private .env
MAP_DB_READONLY_URL=
# M4a screenshot manual ROI evidence: enable only in authorized local deployment
M4A_ENABLED=false
# M4b optional local D-FINE ONNX; CPU model installed ONLY with compose.m4b.yaml
# M4B_ENABLED=true is set by compose.m4b.yaml, not a default
M4B_ENABLED=false
M4B_MODEL_PATH=/models/dfine.onnx
M4B_MODEL_SHA256=
# 大图切片推理：auto（长边 ≤1280 整图、≤2600 切 2×2、更大切 3×3）/ off / 2 / 3
# 3200×1800 整幅缩到 640 会把目标压成十几像素，实测切片后召回翻 5–7 倍
M4B_TILING=auto
# M4d 视觉模型（本机 Ollama）：选图自动框选、框选后出外观线索。
# 权重从 models/README.md 的地址下载后放 models/dfine.onnx；需用 *-instruct 变体，
# thinking 变体（qwen3-vl:2b）只会输出推理、content 为空。
VISION_ENABLED=false
VISION_BASE_URL=http://host.docker.internal:11434
VISION_MODEL=qwen3-vl:2b-instruct
# 4B 作为第二个视觉引擎（engine=qwen3vl4b），2B 保留，可同图对比；
# 6GB 显存放不下两个，切换时 Ollama 自动换出，第一次切会多等几秒。
VISION_MODEL_LARGE=qwen3-vl:4b-instruct
# 关键特征（外观短语）优先用这个模型；缺 4B 时自动回落 VISION_MODEL
VISION_FEATURE_MODEL=qwen3-vl:4b-instruct
VISION_TIMEOUT_SECONDS=180
# M5 模型实验室大模型目录：可同时注册本地 Ollama 和 Rebucca 式远程 OpenAI-compatible API。
# 本地示例：
# M5_VISION_MODELS_JSON=[{"id":"internvl","name":"InternVL","model":"已安装的Ollama标签","provider":"ollama"}]
# 远程示例：本机 .env 添加下方 JSON 和 API_KEY 环境变量，切勿提交凭据。
# M5_VISION_MODELS_JSON=[{"id":"remotevl","name":"远程视觉模型","model":"provider-model-id","provider":"openai_compatible","api_url":"https://api.example.com/v1","api_key_env":"REMOTE_VLM_API_KEY"}]
# REMOTE_VLM_API_KEY=<保存在私有 .env 的密钥>
# 非浏览器输入 URL/密钥；配置的 HTTPS 远程模型可在「大模型管理」及「模型测试」页选择。
M5_VISION_MODELS_JSON=
# M5 Rebucca 图片模型推理（独立 Rebucca Python 环境），默认不开启
# 本地宿主机运行服务，TrajNexa Docker API 经 host.docker.internal 访问。
# Windows Docker Desktop: 若绑定 0.0.0.0，必须设置随机长 Token + 防火墙限制。
# 不要把真实 token、图片、模型权重写进 Git。
M5_REBUCCA_ENABLED=false
M5_REBUCCA_BASE_URL=http://host.docker.internal:8766
M5_REBUCCA_TOKEN=
M5_REBUCCA_TIMEOUT_SECONDS=60
# 研判工作台只使用后端预设的一个检测模型，不受模型实验室勾选影响。
# Rebucca 开启时：留空=第一个已加载模型；否则填 Rebucca 服务已加载模型 ID。
# 无 Rebucca 时：优先 D-FINE 权重；未安装时继续使用原本地 Qwen 回退。
# 前端「小模型/大模型」页「在 Rebucca 中管理」的跳转地址（Vite 构建期变量）
# 也可用 URL 参数临时覆盖：?rebucca=http://192.168.1.10:10001
VITE_REBUCCA_WEB_URL=http://127.0.0.1:10001
M5_WORKSPACE_DETECTOR_ID=
# M4c keyframes from case-owned recording clips; default disabled
M4C_ENABLED=false
# M4c Compose optional host recording folder (example: G:/测试数据/视频)
# RECORDINGS_HOST_ROOT=G:/测试数据/视频
# 视频命名工具是原地改名：VIDEO_NAMING_ROOTS 分号分隔；留空也会兜底到「真实存在的
# 可写挂载点」（容器内 /data/video-library），不会默认放行整块磁盘。
# 要完全放开必须显式写 VIDEO_NAMING_ROOTS=/
# VIDEO_NAMING_ROOTS=/data/video-library
